# Template only. Copy to .env.mainnet (ignored), chmod 600, fill reviewed values.
# verify-mainnet reads ONLY the file passed through --env, never .env or inherited values.
NETWORK=bscMainnet
CHAIN_ID=56
BSC_MAINNET_RPC=
BSC_MAINNET_USDT=0x55d398326f99059fF775485246999027B3197955
BSC_MAINNET_NEMOKEY=
BSC_MAINNET_NFT=
BSC_MAINNET_IDO=
BSC_MAINNET_REWARDS=
BSC_MAINNET_INTEREST=
# Exact final owner after all Ownable2Step acceptOwnership operations.
EXPECTED_OWNER=
EXPECTED_PUBLISHER=
EXPECTED_MAX_ROOT_INCREASE_WEI=
EXPECTED_HISTORICAL_TEAM_BUDGET_WEI=
EXPECTED_TOTAL_IMPORTED_WEI=
# Pick a stable URL returning HTTP 200. Current production asset URL returned 404 on 2026-10-06.
NFT_IMAGE_URI=
# Deployment signer belongs in a secure signer workflow, not this read-only verifier file.
# Production indexer values (do not run before backup, migration and rules sign-off):
RPC_URL=
IDO_ADDRESS=
REWARDS_ADDRESS=
DATABASE_URL=
START_BLOCK=
INDEX_START_BLOCK=
CONFIRMATIONS=15
CHUNK_BLOCKS=2000
# Empty/0: old five tiers. Positive height: switch to V2 at that block; decide explicitly.
TEAM_TIER_SWITCH_BLOCK=
CONTENT_URI=
PUBLIC_DIR=
